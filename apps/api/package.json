{
  "name": "@gesthost/api",
  "version": "0.1.0",
  "private": true,
  "description": "GestHost PMS — API NestJS (modular monolith) PostgreSQL/Drizzle",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
